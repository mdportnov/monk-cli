'tui:Open the interactive TUI' \
'lang:Set the interface language' \
'start:Start a focus session' \
'stop:Stop the active session' \
'panic:Request an escape from hard mode' \
'status:Show daemon and session status' \
'profiles:List profiles' \
'profile:Manage profiles' \
'apps:Manage installed applications cache' \
'stats:Show session statistics' \
'doctor:Check environment, permissions, and daemon health' \
'config:Manage configuration' \
'daemon:Manage the background daemon' \
'completions:Generate shell completions' \
'setup:Interactive first-run setup wizard' \
'help:Print this message or the help of the given subcommand(s)' \
    )
